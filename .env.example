# ==============================================================================
# Vendor Onboarding Gateway - Production Environment Variables Template
# Copy this file to .env.local for local development, or add these keys to your
# Cloudflare / Vercel production environment dashboard.
# ==============================================================================

# 1. Upstash Redis (Stateless Serverless State Management)
# Create a free database at https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://your-database-id.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# 2. Resend API (Transactional Email Dispatch)
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key"
# Optional custom sender address (defaults to onboarding@resend.dev)
RESEND_FROM_EMAIL="onboarding@resend.dev"

# 3. NVIDIA NIM Cloud Inference (AI Trade Name Reasoning)
# Get your API key at https://build.nvidia.com
NVIDIA_API_KEY="nvapi-your_nvidia_api_key"

# 4. Host Base URL
# Local: http://localhost:3000
# Production: https://your-project.vercel.app or https://your-worker.workers.dev
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 5. External Google Form Public Link (Optional)
NEXT_PUBLIC_GOOGLE_FORM_URL="https://forms.google.com"

